# Backend local development settings
PORT=8000
NODE_ENV=development

# Comma-separated origins for storefront and admin Vite development servers
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Atlas base URI only: backend currently appends its configured database name.
# Do not include a database path or query parameters until the connection helper is updated.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net

ACCESS_TOKEN_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_NEW_RANDOM_SECRET
REFRESH_TOKEN_EXPIRY=7d

CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_NEW_API_KEY
CLOUDINARY_API_SECRET=YOUR_NEW_API_SECRET

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_NEW_STRONG_PASSWORD
ADMIN_TOKEN_SECRET=REPLACE_WITH_THIRD_NEW_RANDOM_SECRET
